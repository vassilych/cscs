<?xml version="1.0" encoding="utf-8"?>
<!--
  Drop this next to script.cscs in C:\inetpub\wwwroot\shared\.

  Without it IIS refuses to serve script.cscs at all: an extension it has no MIME mapping
  for comes back as HTTP 404.3 ("the page you are requesting cannot be served because of
  the extension configuration"), which reads like a missing file but is not one.

  text/plain is deliberate, because it makes the script readable in a browser, which is
  handy when checking the URL by hand.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <!-- Remove first, so re-deploying (or a mapping inherited from a parent config)
           cannot produce a duplicate entry 500. -->
      <remove fileExtension=".cscs" />
      <mimeMap fileExtension=".cscs" mimeType="text/plain" />

      <!-- Scripts are fetched to be run, so never hand out a stale cached copy. -->
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>
</configuration>
