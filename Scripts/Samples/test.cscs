print("Testing Web Requests/JSON/Marshalling");
baseURL = "https://www.alphavantage.co/query?function=TIME_SERIES_WEEKLY&symbol=";
// The key comes from the environment rather than the repository. A free Alpha Vantage key
// allows 25 requests a day, so one committed here is shared by everyone who runs the suite
// and is throttled most of the time -- which used to fail this file for a reason that has
// nothing to do with the code. Set CSCS_ALPHAVANTAGE_KEY to exercise this section.
apikey  = env("CSCS_ALPHAVANTAGE_KEY");
symbol  = "MSFT";
stockUrl = baseURL + symbol + "&apikey=" + apikey;


class Stock {
  symbol = "";
  date = "";
  open = 0;
  low = 0;
  high = 0;
  close = 0;
  volume = 0;
  Stock(symb, dt, data) {
    symbol = symb;
    date   = dt;
    open   = Math.Round(data["1. open"], 2);
    high   = Math.Round(data["2. high"], 2);
    low    = Math.Round(data["3. low"],  2);
    close  = Math.Round(data["4. close"],2);
    volume = data["5. volume"];
  }
  function ToString() {
    return symbol + " " + date + ". Open: " + open +
      ", Close: " + close + ": Low: " + low + 
      ", High: " + high + ", Volume: " + Volume;
  }
}
// The Alpha Vantage key above is a free one and is rate-limited (25 requests a day), so this
// has to cope with a reply that carries no quote data. Such a reply says "Information" or
// "Note" rather than "Error", so it slipped past the old check and threw on jsonFromText[1] --
// which stopped the whole file, taking every assertion after this point with it. Returning a
// string instead lets the caller skip just the checks that need live data.
function processResponse(text)
{
  if (text.contains("Error") || text.contains("Information") || text.contains("Note")) {
    return text;
  }
  jsonFromText = GetVariableFromJSON(text);
  if (jsonFromText.Size < 2) {
    return text;      // not the {metadata, series} pair this expects
  }
  metaData     = jsonFromText[0];
  result       = jsonFromText[1];
  symbol       = metaData["2. Symbol"];
  last         = metaData["3. Last Refreshed"];
  allDates     = result.keys;
  dateData     = result[allDates[0]];
  myStock = new Stock(symbol, last, dateData);
  return myStock;
}

// Why the live checks cannot run, or "" when they can. processResponse returns a Stock on
// success and the raw reply otherwise, so the checks are skipped rather than failing the run
// for a reason outside this repository.
stockSkip = "";
if (apikey == "") {
  stockSkip = "CSCS_ALPHAVANTAGE_KEY is not set";
} else {
  result = WebRequest("GET", stockUrl, "", symbol);
  stock  = processResponse(result);
  if (stock.type == "STRING") {
    stockSkip = "no quote data (the key is rate-limited); reply: " + stock;
  }
}

if (stockSkip != "") {
  print("Skipping the stock checks: ", stockSkip);
} else {
  print(stock); // MSFT 2022-09-02. Open: 261.7, Close: 256.06: Low: 254.47, High: 264.74, Volume: 22855380
  Test(stock.StartsWith(symbol), true);

  ms = Marshal(stock); // Returns:
  // <mystock:class:stock><symbol:STR:"MSFT"><date:STR:"2022-09-02"><open:NUM:261.7>
  // <low:NUM:254.47><high:NUM:264.74><close:NUM:256.06><volume:STR:"22855380">
  Test(ms.type, "STRING");
  ums = Unmarshal(ms);
  Test(stock.ToString(), ums.ToString()); // test that we can unmarshall to the original
  Test(ums.type, "SplitAndMerge.CSCSClass+ClassInstance: Stock");
}

