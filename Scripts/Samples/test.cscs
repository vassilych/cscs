}

Print("Testing bitwise operators...");
// "&" is bitwise AND. It used to be the reference operator, so "5 & 3" parsed as
// "take a reference to 3" and died with a null reference. The reference operator is "@".
Test(5 & 3, 1);
Test(12 & 10, 8);
Test(255 & 15, 15);
Test(5 | 3, 7);
Test(5 ^ 3, 6);
Test(1 && 1, 1);
Test(1 && 0, 0);
Test(0 || 1, 1);

// Bitwise NOT. "~" used to be collected into the operand itself, so "~n" was looked up
// as a variable by that name and the script died with "Couldn't find variable [~n]".
nBits = 3;
Test(~nBits, -4);
Test(~0, -1);
Test(~~nBits, 3);
Test(~-1, 0);
Test((~nBits) & 255, 252);
Test(5 & ~3, 4);

Print("Testing do-while loops...");
// A do-loop consumes both its body and its trailing "while (...)", so there is no block
// left to skip afterwards. Skipping one anyway made every do-loop followed by another
// statement die with "Couldn't skip block", and break/continue/return each left the
// pointer somewhere in the middle of the body.
doI = 0;
do {
  doI++;
} while (doI < 4);
Test(doI, 4);

doOnce = 0;
do {
  doOnce++;
} while (false);
Test(doOnce, 1);

doBreak = 0;
do {
  doBreak++;
  if (doBreak == 2) { break; }
} while (doBreak < 9);
Test(doBreak, 2);

// continue still has to test the condition, exactly as in a while loop.
doCont = 0;
doSum  = 0;
do {
  doCont++;
  if (doCont == 2) { continue; }
  doSum += doCont;
} while (doCont < 4);
Test(doCont, 4);
Test(doSum, 8);

function doReturnTest() {
  n = 0;
  do {
    n++;
    if (n == 3) { return n * 10; }
  } while (n < 9);
  return -1;
}
Test(doReturnTest(), 30);

doOuter = 0;
doInner = 0;
do {
  doInner = 0;
  do {
    doInner++;
  } while (doInner < 3);
  doOuter++;
} while (doOuter < 2);
Test(doOuter, 2);
Test(doInner, 3);

Print("Testing IndexOf...");
// IndexOf matches case, like the standalone StrIndexOf function and like C#. It used to
// default to "no_case", so it was the one string member that ignored case.
idxStr = "abcd";
Test(idxStr.IndexOf("c"), 2);
Test(idxStr.IndexOf("C"), -1);
Test(idxStr.IndexOf("C", 0, "no_case"), 2);
Test(StrIndexOf(idxStr, "C"), -1);
// Contains, StartsWith and EndsWith match case the same way.
Test(idxStr.Contains("BC"), 0);
Test(idxStr.Contains("bc"), 1);
Test(idxStr.Contains("BC", "no_case"), 1);
Test(idxStr.StartsWith("AB"), 0);
Test(idxStr.StartsWith("ab"), 1);
Test(idxStr.EndsWith("CD"), 0);
Test(idxStr.EndsWith("cd"), 1);
// Map keys are stored lower-cased, so Contains on a map agrees with indexing rather than
// with the case-sensitive string rule.
idxMap = {"K1" : 1};
Test(idxMap.Contains("k1"), 1);
Test(idxMap["k1"], 1);

Print("Testing this inside class methods...");

// "this" was registered once, globally, as an empty array and never bound to the instance a
// method runs on, so "this.field" threw "Sequence contains no elements".
class ThisBox {
  tv = 0;
  ThisBox(v) { tv = v; }
  function Plain() { return tv; }
  function ViaThis() { return this.tv; }
  function ViaThisCall() { return this.Plain() * 2; }
  function Sum(k) { return this.tv + k; }
}
thisBoxed = new ThisBox(7);
Test(thisBoxed.Plain(), 7);
Test(thisBoxed.ViaThis(), 7);
Test(thisBoxed.ViaThisCall(), 14);
Test(thisBoxed.Sum(3), 10);

// A compiled function calling a method that uses "this".
Print("Testing a statement after try/catch...");

// A try/catch handed back the value of its last statement instead of an empty one, so the
// parser stayed inside the same expression and the next statement -- an assignment -- was
// merged into it: "Can't process last token [2]". A ";" right after the "}" used to hide it.
try { tcx = 1; } catch (e) { }
tcy = 2;
Test(tcy, 2);
if (1 == 1) { try { tcx = 3; } catch (e) { } tcz = 4; Test(tcz, 4); }
function tryThenAssign(n) { try { a1 = n; } catch (e) { } a2 = 5; return a1 + a2; }
Test(tryThenAssign(1), 6);
function tryThenAssignLoop(n) { t = 0; i = 0; while (i < n) { try { t += i; } catch (e) { } i++; } return t; }
Test(tryThenAssignLoop(4), 6);
function tryFinallyThenAssign(n) { try { b1 = n; } catch (e) { } finally { b2 = 1; } b3 = 2; return b1 + b2 + b3; }
Test(tryFinallyThenAssign(1), 4);
// break, continue and return out of a try still work.
function tryBreaks(n) { t = 0; for (i = 0; i < n; i++) { try { if (i == 2) { break; } t += i; } catch (e) { } } return t; }
Test(tryBreaks(5), 1);
function tryReturns(n) { try { return n * 2; } catch (e) { return -1; } return 0; }
Test(tryReturns(4), 8);

Print("Testing a method calling a sibling method...");

// A bare call to another method of the same class resolved through the name the instance was
// assigned to. An instance built inside a function is a local there, invisible from the
// lookup, so such a call failed with "Sequence contains no elements". It goes through "this"
// now, which is the instance itself.
class SibCalc {
  sv = 0;
  SibCalc(v) { sv = v; }
  function Base() { return sv; }
  function Doubled() { return Base() * 2; }
  function ViaThis() { return this.Base() * 3; }
}
sibTop = new SibCalc(5);
Test(sibTop.Doubled(), 10);
Test(sibTop.ViaThis(), 15);
function sibInFn(n) { p = new SibCalc(n); return p.Doubled(); }
Test(sibInFn(5), 10);
function sibMaker(n) { return new SibCalc(n); }
sibMade = sibMaker(5);
Test(sibMade.Doubled(), 10);
Print("Testing language constructs not covered elsewhere...");

// iff() picks between two values, like a ternary written as a call. It is a statement, so
// its result is read into a variable first -- nested in another call it swallows what
// follows it.
iffTrue = iff(5 > 2, "big", "small");
iffFalse = iff(1 > 2, "big", "small");
Test(iffTrue, "big");
Test(iffFalse, "small");

// The interpreter implements no shift: both of these are worth pinning, because compiled code
// must not "improve" on them (C#'s shift would say 12 and 4).
Test(3 << 2, 0);
Test(8 >> 1, 1);

// A name the interpreter holds, or does not.
Test(NameExists("noSuchNameHere"), false);
nameNowExists = 1;
Test(NameExists("nameNowExists"), true);

// DeepCopy detaches a collection; a plain assignment aliases it.
dcOrig = {3, 1, 2};
dcCopy = DeepCopy(dcOrig);
dcCopy.Add(9);
Test(dcOrig.Size, 3);
Test(dcCopy.Size, 4);
dcAlias = dcOrig;
dcAlias.Add(9);
Test(dcOrig.Size, 4);

// Tokenizing, and text between two markers.
Test(Tokenize("a,b,c", ",").Size, 3);
Test(StrBetween("x[y]z", "[", "]"), "y");

// Substring clamps instead of throwing, At gives one character, and Contains can ignore case.
clampMe = "abcd";
Test(clampMe.Substring(2, 99), "cd");
Test(clampMe.At(1), "b");
Test(clampMe.Contains("BC", "no_case"), true);
Test(clampMe.Contains("BC"), false);

// Split takes its argument as one separator, not as a set of characters.
sepText = "a,b;c";
Test(sepText.Split(",;").Size, 1);
Test(sepText.Split(",").Size, 2);

// Iterating a map walks its values; Keys walks the keys.
iterMap = {"a": 1, "b": 2};
iterValues = "";
for (k in iterMap) { iterValues += k; }
Test(iterValues, "12");
iterKeys = "";
for (k in iterMap.Keys) { iterKeys += k; }
Test(iterKeys, "ab");
Test(iterMap.Size, 2);
Test(iterMap.Type, "ARRAY");

// finally runs after the catch.
finOrder = 0;
try { finOrder = 1; throw "x"; } catch (e) { finOrder += 10; } finally { finOrder += 100; }
Test(finOrder, 111);

// "\n" becomes one character when the literal is read; "\t" stays two, and Print turns it
// into a tab on the way out.
nlText = "a\nb";
tabText = "a\tb";
Test(nlText.Length, 3);
Test(tabText.Length, 4);

// Division by zero and its relatives are doubles, and print as such.
Test("" + 5 / 0, "∞");
Test("" + 5 % 0, "NaN");
Test("" + 1 / 10000000, "1E-07");
Test("" + 1e10 * 1e10, "1E+20");

// A minus in front of a group, and a comparison chain.
Test(-(2 + 1), -3);
Test(1 < 5 < 10, true);

Print("Testing the power operator and more math...");

// "**" groups to the right: 2 ** 3 ** 2 is 2 ** 9, not 8 ** 2.
powTen = 2 ** 10;
powAssoc = 2 ** 3 ** 2;
Test(powTen, 1024);
Test(powAssoc, 512);
powVar = 3;
Test(powVar ** 2, 9);
Test(2 ** powVar, 8);

// Math functions not covered above.
Test(Math.Round(Math.Atan2(1, 1), 4), 0.7854);
Test(Math.Floor(2.7), 2);
Test(Math.Ceiling(2.1), 3);
Test(Math.Round(Math.Sin(0), 6), 0);
Test(Math.Round(Math.Cos(0), 6), 1);
Test(Math.Abs(-5), 5);
Test(Math.Min(3, 7), 3);
Test(Math.Max(3, 7), 7);
Test(Math.Round(Math.Sqrt(16), 6), 4);
Test(Math.Round(Math.Pow(2, 10), 6), 1024);

Print("Testing collection and text built-ins...");

// Sorting and reversing a collection in place.
sortMe = {3, 1, 2};
sortMe.Sort();
Test(sortMe[0], 1);
Test(sortMe[2], 3);
revMe = {1, 2, 3};
revMe.Reverse();
Test(revMe[0], 3);
Test(revMe[2], 1);

// First and last, and the position of a value.
endsMe = {5, 6, 7};
Test(endsMe.First, 5);
Test(endsMe.Last, 7);
// IndexOf on a collection searches its text form -- "[5, 6, 7]" -- so 6 sits at 4 there.
// find_index is the one that gives the position of an element.
Test(endsMe.IndexOf(6), 4);
Test(find_index(endsMe, 6), 1);

// Removing by value and by position, and adding only what is not there yet.
remMe = {1, 2, 3};
remMe.Remove(2);
Test(remMe.Size, 2);
Test(remMe[1], 3);
atMe = {1, 2, 3};
atMe.RemoveAt(0);
Test(atMe.Size, 2);
Test(atMe[0], 2);
uniqMe = {1, 2};
uniqMe.AddUnique(2);
uniqMe.AddUnique(3);
Test(uniqMe.Size, 3);
remMap = {"a": 1, "b": 2};
remMap.Remove("a");
Test(remMap.Size, 1);

// The plain-function forms of the text helpers.
Test(StrUpper("ab"), "AB");
Test(StrTrim(" a "), "a");
Test(StrContains("abc", "B", "no_case"), true);
Test(StrContains("abc", "B"), false);
// Two names are deliberately not tested here. EmptyOrWhite is in the constants table but no
// function is registered under it ("Couldn't find function"). And typeOf(), at statement
// level, reads raw tokens and swallows the rest of the script -- everything after it stopped
// running, with no error at all -- so it is left to the places that already use it.

Print("Testing Misc. Functions...");
z = typeof xw_undef;
typeof z === 'undefined';
if (typeof z === 'undefined') {
    print ("Not defined!"); Test(true, true);
} else {
    print ("Defined!"); Test(true, false);
}
if (z != undefined) {
    print ("Defined!"); Test(true, false);
} else {
    print ("Not defined!"); Test(true, true);
}

Test(NameExists(IamABrandNewName), false);
Test(NameExists(arr), true);

for (i = 0; i < 2; i++) {
  if( !NameExists( MyNewFunction )) {
    function MyNewFunction(object) { 
      print( "MyNewFunction");
    };
    print( "Just defined MyNewFunction");
    Test(i, 0);
  } else {
    print( "MyNewFunction Exists" );
    Test(i >= 0, true);
  }
}

strArray = {"z3", "b2", "a1"};
numArray = {51, 39, 33};
Test(strArray.Sort(), {"a1", "b2", "z3"});
