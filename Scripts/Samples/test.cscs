function compute(base, power, str, extra) {
  x = Math.pow(base, power) * extra;
  newStr = "Hi " + str;
  return x;
}
function work(loops) {
  x = 0.0;
  for(i = 0; i < loops; i++) {
     x = (2*compute(2, 3, "Test", 1000) + 2000)/2;
  }
  return (2*compute(2, 3, "Test", 1000) + 2000)/2;
}
Test(work(1), 9000);

