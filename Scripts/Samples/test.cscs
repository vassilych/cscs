namespace ns1 {
  class CurrentDate {
    day = "";
    month = "";
    year = "";
    function setDay(n) {
      day = n;
    }
    function setMonth(n) {
      month = n;
    }
    function setYear(n) {
      year = n;
    }

    function setCompositDate(value) {
      // incoming value 8/23/2017
      items = value.split("/");
      Test(items.size, 3);
      setMonth(items[0]);
      setDay(items[1]);
      setYear(items[2]);
    }

    function toString() {
      return month + "/" + day + "/" + year;
    }
  }

  date = "8/23/2017";
  dt = new CurrentDate();
  dt.setCompositDate(date);
  Test(dt, date);
}
