result = returnTest(19);
Test(result, 2); Test(b, 20);
result = returnTest(30);
Test(result, 3); Test(b, 20);
result = returnTest(40);
Test(result, 4); Test(b, 40);
result = returnTest(50);
Test(result, 5); Test(b, 60);

