class Box { v = 0; tag = ""; items = {}; l = {5, 6}; m = {"k": 1}; g = {{1, 2}}; Box(a, b) { v = a; tag = b; items = {}; l = {5, 6}; m = {"k": 1}; g = {{1, 2}}; } function Get() { return v; } function Tag() { return tag; } function Bump() { v++; return v; } function Add(x) { items.Add(x); return items.Size; } }
