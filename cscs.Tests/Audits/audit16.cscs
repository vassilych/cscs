class AgShape { name = ""; AgShape(n) { name = n; } function Describe() { return name + " area " + Area(); } }
class AgCircle : AgShape { r = 0; AgCircle(radius) { name = "circle"; r = radius; } function Area() { return Math.Round(Math.PI * r * r, 2); } }
class AgCounter { count = 0; function Inc(k) { count += k; return count; } }
