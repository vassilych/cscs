function tInt(int n) { return n * 2; }
function tStr(string s) { return s + "!"; }
function tDef(int n, string s = "d") { return n + s; }
function tList(List<int> xs) { return xs.Size + "|" + xs[0]; }
function tail(v) { return v; }
function tRec(s) { if (s.Size <= 1) return s; return tRec(s.Substring(1)) + s[0]; }
function tNum(double d) { return d / 2; }

