14 Heading2 | Split and Merge in One Page
15 BodyText | Split-and-Merge evaluates an expression in two passes. The split pass 
16 BodyText | 
17 CodeSnippet | [3, +]   [4, *]   [2, -]   [1, )]
18 BodyText | 
19 BodyText | The last cell carries a null action, which has the lowest priority of 
20 BodyText | 
21 BodyText | The merge pass then walks the list from left to right and merges each 
22 BodyText | 
23 CodeSnippet | private static Variable Merge(Variable current, ref int index,
24 CodeSnippet |     List&lt;Variable&gt; listToMerge, ParsingScript script,
25 CodeSnippet |     bool mergeOneOnly = false)
26 CodeSnippet | {
27 CodeSnippet |     while (index &lt; listToMerge.Count)
28 CodeSnippet |     {
29 CodeSnippet |         Variable next = listToMerge[index++];
30 CodeSnippet |         while (!CanMergeCells(current, next))
31 CodeSnippet |         {
32 CodeSnippet |             // 1+2*3: merge 2*3 first, getting 6, then 1+6.
33 CodeSnippet |             Merge(next, ref index, listToMerge, script,
34 CodeSnippet |                   true /* mergeOneOnly */);
35 CodeSnippet |         }
36 CodeSnippet |         MergeCells(current, next, script);
37 CodeSnippet |         if (mergeOneOnly) { break; }
38 CodeSnippet |     }
39 CodeSnippet |     return current;
40 CodeSnippet | }
