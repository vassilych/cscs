135 CodeSnippet | Precompiler.FallbackToInterpreter = true;         // the default
136 CodeSnippet | Precompiler.Fallbacks["myFunc"]                    // why it was not c
137 CodeSnippet | is_precompiled("myFunc")                           // from a script: 1
