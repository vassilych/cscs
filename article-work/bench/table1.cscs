function numI(n) { t = 0.0; for (i = 0; i < n; i++) { t += i * 0.5 - i / 3; } return t; }
cfunction double numC(int n) { t = 0.0; for (i = 0; i < n; i++) { t += i * 0.5 - i / 3; } return t; }
function intI(n) { t = 0; for (i = 0; i < n; i++) { if (i % 3 == 0) { t += i % 7; } } return t; }
cfunction int intC(int n) { t = 0; for (i = 0; i < n; i++) { if (i % 3 == 0) { t += i % 7; } } return t; }
function fibI(n) { if (n < 2) { return n; } return fibI(n - 1) + fibI(n - 2); }
cfunction double fibC(int n) { if (n < 2) { return n; } return fibC(n - 1) + fibC(n - 2); }
numC(10); intC(10); fibC(5); numI(10); intI(10); fibI(5);
a = pstime(); x = numI(100000); b = pstime(); y = numC(100000); c = pstime(); print("T|numeric 100k|" + (b - a) + "|" + (c - b) + "|" + (x == y));
a = pstime(); x = intI(100000); b = pstime(); y = intC(100000); c = pstime(); print("T|int 100k|" + (b - a) + "|" + (c - b) + "|" + (x == y));
a = pstime(); y = intC(10000000); b = pstime(); print("T|int 10M||" + (b - a) + "|");
a = pstime(); x = fibI(20); b = pstime(); y = fibC(20); c = pstime(); print("T|fib(20)|" + (b - a) + "|" + (c - b) + "|" + (x == y));
a = pstime(); y = fibC(30); b = pstime(); print("T|fib(30)||" + (b - a) + "|" + y);
